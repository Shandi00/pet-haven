# Copy to backend/.env and fill in local values.

# Application
NODE_ENV=development
PORT=5000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/pet_adoption

# Independent random secrets
JWT_SECRET=change_me_to_a_secure_value
SESSION_SECRET=change_me_to_a_secure_value

# Frontend origins (comma separated)
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Google OAuth (leave empty when unused)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Uploads
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=5242880

# Database connection retries
DB_CONNECT_MAX_RETRIES=5
DB_CONNECT_DELAY_MS=2000

# Integration test readiness polling
READINESS_RETRIES=20
READINESS_DELAY_MS=1000

# Optional logging
# LOG_LEVEL=info
