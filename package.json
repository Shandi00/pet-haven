{
  "name": "pet-haven",
  "version": "1.0.0",
  "private": true,
  "description": "Pet Haven development commands",
  "scripts": {
    "setup": "python -m venv backend/.venv && node scripts/py.js -m pip install -r requirements.txt && npm ci --prefix frontend",
    "dev:backend": "node scripts/py.js -m uvicorn app.main:asgi_app --reload --port 5000",
    "dev:frontend": "npm --prefix frontend start",
    "build": "npm --prefix frontend run build",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "node scripts/py.js -m pytest",
    "test:frontend": "npm --prefix frontend test -- --watchAll=false --runInBand",
    "test:e2e": "npm --prefix frontend run test:e2e",
    "seed": "node scripts/py.js seed.py"
  }
}
