{
  "name": "pet-haven",
  "version": "1.0.0",
  "private": true,
  "description": "Pet Haven development commands",
  "scripts": {
    "setup": "npm ci --prefix backend && npm ci --prefix frontend",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend start",
    "build": "npm --prefix frontend run build",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "npm --prefix backend run test:unit -- --runInBand",
    "test:frontend": "npm --prefix frontend test -- --watchAll=false --runInBand",
    "test:e2e": "npm --prefix frontend run test:e2e"
  }
}
