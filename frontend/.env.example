# 前端環境變數範例。值一律留空，不要把真實帳號密碼寫進版本庫。

# Playwright e2e 用的帳號；執行 npm run test:e2e 前在終端機設定，
# 例如 PowerShell：$env:E2E_USER_EMAIL="..."; $env:E2E_USER_PASSWORD="..."
# 沒有設定時，需要該帳號的 e2e 測試會跳過。說明見 frontend/E2E_TESTING_GUIDE.md。

# 一般使用者（user）帳號：e2e/match-game.spec.js、e2e/profile.spec.js
E2E_USER_EMAIL=
E2E_USER_PASSWORD=

# 管理員（admin）帳號：e2e/auth.spec.js 的管理員登入、e2e/dashboard.spec.js
# 建立方式：在 backend/ 執行 .venv/Scripts/python -m scripts.create_admin --email <email>
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=

# 以下是建置前端時讀取的設定（放在 frontend/.env，改完要重新啟動 npm start 或重新 build）。
# Google 登入的用戶端 ID；留空時不顯示 Google 登入按鈕。
REACT_APP_GOOGLE_CLIENT_ID=
# 人機驗證（Cloudflare Turnstile）的 site key；留空時不顯示驗證、也不需要驗證（後端 TURNSTILE_SECRET_KEY 要一起設定）。
# 本機想測試畫面時可用 Cloudflare 公開的測試 site key 1x00000000000000000000AA（永遠通過）。
REACT_APP_TURNSTILE_SITE_KEY=
