# 複製成 backend/.env 後填入；不要 commit .env

# MongoDB Atlas 格式：mongodb+srv://<user>:<password>@pet-haven.r1angoh.mongodb.net/?compressors=zlib
MONGODB_URI=
# 連線字串裡沒有資料庫名稱，必須另外指定
MONGODB_DB=pet_haven

# JWT 簽章密鑰（至少 32 字元的隨機字串）
JWT_SECRET=

# development：登入失敗限制較寬鬆；production：較嚴格
APP_ENV=development

# 前端來源（逗號分隔）與網址（Google 登入完成後導回）
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Google 登入（不用時留空）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# AI（T12 使用，只在後端讀取；規則見 docs/api/新增API契約.md §0）
GEMINI_API_KEY=
# 要改預設值時才取消註解並填值；留空的未註解行會讓設定讀取失敗
# GEMINI_MODEL=            （預設 gemini-3.1-flash-lite）
# LLM_TIMEOUT_SECONDS=     （預設 8）

# npm run seed 建立的收容所帳號（shelter@example.com）密碼。留空時用公開的預設密碼，只能用在本機與 CI；
# 展示機一定要設定。已 seed 過的資料庫設定後重跑 npm run seed，會把密碼換成這個值。
# e2e 也讀同名環境變數（在執行 npm run test:e2e 的終端機設定）。
SEED_SHELTER_PASSWORD=

# 上傳檔案目錄（相對 backend/）
UPLOAD_PATH=uploads

# log 等級：DEBUG / INFO / WARNING
LOG_LEVEL=INFO
