# 複製成 backend/.env 後填入；不要 commit .env

# MongoDB Atlas 格式：mongodb+srv://<user>:<password>@pet-haven.r1angoh.mongodb.net/?compressors=zlib
MONGODB_URI=
# 連線字串裡沒有資料庫名稱，必須另外指定
MONGODB_DB=pet_haven

# JWT 簽章密鑰（至少 32 字元的隨機字串）
JWT_SECRET=

# development：登入失敗限制較寬鬆；production：較嚴格
APP_ENV=development

# 前端來源（逗號分隔）與網址（Google 登入完成後導回）
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Google 登入（不用時留空）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# AI（T12 使用，只在後端讀取）
GEMINI_API_KEY=

# 上傳檔案目錄（相對 backend/）
UPLOAD_PATH=uploads
